  "findings": [
    "Main render and visual/batch work exceed camera/HUD mean costs in all three existing captures. Nested phases must not be summed.",
    "All three recorded >100ms raw gaps in browser-final have launchRendered=false. Current callback CPU 23.1/32.1/42.6ms does not identify the cause of the preceding gap.",
    "FrameProfiler finishedAt is not callback return. Current raw gap and current CPU describe different intervals; subtracting them would not establish missing time.",
    "Previous original Unit38/40/50/54 instrumented inner frame/GL/heap and left the full callback-return boundary unresolved. Do not repeat those probes as a new optimization.",
    "Current candidate performed worse than both latest-source baseline observations. Keep all raw evidence; no new overall improvement claim."
  ],
  "next": {
    "title": "Lightweight outer frame callback boundary diagnostic",
    "action": "Read current frame-scheduler and profiler bookkeeping; create WORK-only bounded callback-start/return history including previous callbacks, clock scheduling origin and profiler-end boundary, with separate phase history. Check harness overhead and exception/stop behavior before a controlled capture. Do not change game scheduling or product defaults merely to collect data.",
    "decision": "Select an implementation only after attributable cost and preservation checks; avoid another no-change reference capture or the already rejected Unit42 index-deferral microchange."
  },
  "limits": [
    "Existing captures are separate non-isolated browser rAF runs, not native Steam presentation measurements.",
    "No GC/GPU/driver/host root cause established.",
    "No source, Windows package, user storage, server, browser tab, original or release automation changed during this analysis."
  ]
}
